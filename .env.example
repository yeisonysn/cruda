# Puerto del servidor
PORT=4000

# Seguridad y Autenticación de Administrador
ADMIN_USER=admin
ADMIN_PASSWORD=1234
JWT_SECRET=cruda_jwt_secret_change_in_production

# Base de Datos (PostgreSQL en M02)
DATABASE_URL=postgresql://cruda_user:cruda_password@localhost:5432/cruda_db?schema=public

# Almacenamiento S3 Compatible (M09)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Pasarela de Pagos (Wompi en M08)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Automatizaciones n8n (M10)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
