# Superusuario de PostgreSQL (lo usan n8n internamente y tú como administrador para aprobar)
POSTGRES_USER=cruda_admin
POSTGRES_PASSWORD=cambia_esta_clave_admin

# Usuario de PostgreSQL con permisos mínimos para el Agente IA (solo SELECT/INSERT, no puede aprobar)
POSTGRES_AGENT_PASSWORD=agente_cambiar_123

# Base de datos interna de n8n (workflows, credenciales). La base de negocio "cruda" la crea 01-init.sql
POSTGRES_DB=n8n

# Clave que cifra las credenciales guardadas en n8n. Genérala con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# URL base para Webhooks y OAuth2 (Google Drive, WhatsApp Cloud API, etc.)
WEBHOOK_URL=http://localhost:5678/

# Zona horaria para n8n, los nodos Schedule y PostgreSQL
GENERIC_TIMEZONE=America/Bogota
